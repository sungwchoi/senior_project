<launch>

  <!-- PointCloud2 → LaserScan 변환 -->
  <node pkg="pointcloud_to_laserscan" exec="pointcloud_to_laserscan_node" name="pcl2_to_scan" output="screen">
    <remap from="cloud_in" to="/velodyne_points"/>   <!-- LiDAR 원본 PointCloud2 -->
    <!-- <remap from="scan" to="/scan_filtered"/> -->     <!-- 출력 LaserScan 이름 -->

    <!-- QoS: publisher(/scan) → Best Effort -->
    <param name="qos_overrides./scan.publisher.reliability" value="best_effort"/>
    <param name="qos_overrides./scan.publisher.history"     value="keep_last"/>
    <param name="qos_overrides./scan.publisher.depth"       value="10"/>
    <param name="qos_overrides./scan.publisher.durability"  value="volatile"/>

    <!-- 변환 파라미터 (사람 다리만 추출하도록 슬라이스) -->
    <param name="target_frame"         value="velodyne"/>
    <param name="transform_tolerance"  value="0.01"/>
    <param name="min_height"           value="-0.5"/>  <!-- 수평면 ±20cm -->
    <param name="max_height"           value="0.75"/>
    <param name="angle_min"            value="-1.5708"/> <!-- π-45° → 뒤쪽 범위 시작 -->
    <param name="angle_max"            value="1.5708"/> <!-- π+45° → 뒤쪽 범위 끝 -->
    <param name="angle_increment"      value="0.003"/> <!-- ~0.25° -->
    <param name="range_min"            value="0.3"/>
    <param name="range_max"            value="3.0"/>
    <param name="use_inf"              value="true"/>
    <param name="inf_epsilon"          value="1.0"/>
  </node>

  <!-- Obstacle Extractor (이제 /scan_filtered 사용) -->
  <node name="obstacle_extractor" pkg="obstacle_detector" exec="obstacle_extractor_node" output="screen">
    <remap from="scan" to="/scan_filtered" />
    <param name="active"               value="true"/>
    <param name="use_scan"             value="true"/>
    <param name="use_pcl"              value="false"/>
    <param name="use_pcl2"             value="false"/>

    <!-- QoS: subscription(/scan_filtered) → Best Effort -->
    <param name="qos_overrides./scan_filtered.subscription.reliability" value="best_effort"/>
    <param name="qos_overrides./scan_filtered.subscription.history"     value="keep_last"/>
    <param name="qos_overrides./scan_filtered.subscription.depth"       value="10"/>
    <param name="qos_overrides./scan_filtered.subscription.durability"  value="volatile"/>
    
    <param name="use_split_and_merge"  value="true"/>
    <param name="circles_from_visibles" value="true"/>
    <param name="discard_converted_segments" value="false"/>
    <param name="transform_coordinates" value="false"/>

    <param name="min_group_points"     value="10"/> <!-- 하나의 군집으로 인정되기 위한 최소 포인트 개수-->
    <param name="max_group_distance"   value="0.08"/> <!-- 같은 군집으로 묶을 때 허용하는 인접 포인트 간 최대 거리-->
    <param name="distance_proportion"  value="0.006"/> <!-- -->
    <param name="max_split_distance"   value="0.18"/> <!-- -->
    <param name="max_merge_separation" value="0.20"/>
    <param name="max_merge_spread"     value="0.20"/>
    <param name="max_circle_radius"    value="0.3"/>
    <param name="radius_enlargement"   value="0.15"/>

    <param name="frame_id"             value="velodyne"/>
  </node>
  
  <!-- Obstacle Tracker -->
  <node name="obstacle_tracker" pkg="obstacle_detector" exec="obstacle_tracker_node" output="screen">
    <remap from="/odom" to="/odometry/filtered" />

    <param name="active"                  value="true"/>
    <param name="loop_rate"               value="30.0"/> <!-- CPU 줄이려 낮춤 -->
    <param name="tracking_duration"       value="2.0"/>
    <param name="min_correspondence_cost" value="0.7"/>
    <param name="std_correspondence_dev"  value="0.2"/>
    <param name="process_variance"        value="0.1"/>  
    <param name="process_rate_variance"   value="0.1"/>  
    <param name="measurement_variance"    value="1.0"/>  

    <param name="frame_id"                value="velodyne"/>

    <remap from="tracked_obstacles" to="obstacles"/>
    <remap from="tracked_obstacles_visualization" to="obstacles_visualization"/>
  </node>

</launch>
